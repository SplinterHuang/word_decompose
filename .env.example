# Local bind defaults (public DNS/tunnel is owned elsewhere; forwards to WEB_PORT)
WEB_HOST=127.0.0.1
WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=4000

# development | production
NODE_ENV=development

# Scripted process set: dev | test (same ports for now; separate pid/log dirs)
# APP_ENV=test

# --- Future Neo4j (read-only). Do not put real passwords in git. ---
# Shared Bolt on the deploy host; this app must not write to the DB.
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
