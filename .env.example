# Local bind defaults (public DNS/tunnel is owned elsewhere; forwards to WEB_PORT)
WEB_HOST=127.0.0.1
WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=4000

# development | production
NODE_ENV=development

# Scripted process set: dev | test (same ports for now; separate pid/log dirs)
# APP_ENV=test

# --- Neo4j. Do not put real passwords in git. ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Graph write auth (deploy only). Required for marking Word nodes unfamiliar. ---
# Set on the deploy host (.env loaded by scripts/start.sh). Never commit a real value.
GRAPH_WRITE_PASSWORD=
